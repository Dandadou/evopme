{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evopme",
  "main": "_worker.js",
  "compatibility_date": "2026-09-18",
  "observability": {"enabled": true},
  "vars": {
    "CONTACT_EMAIL": "info@evolutionpme.ca",
    "RESEND_FROM": "Évolution PME <formulaires@evoot.evolutionpme.ca>"
  },
  "assets": {"directory": ".", "binding": "ASSETS"},
  "d1_databases": [
    {
      "binding": "CMS_DB",
      "database_name": "evolution-cms",
      "database_id": "ad7a8f77-6982-4944-a0bc-0a68d8be1253"
    }
  ]
}
