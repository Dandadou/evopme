{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evopme",
  "main": "_worker.js",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
  "vars": {
    "CONTACT_EMAIL": "info@evolutionpme.ca",
    "RESEND_FROM": "Évolution PME <formulaires@evoot.evolutionpme.ca>"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
